# Compose project namespace on the shared server (container names become kg-api-1 etc.)
COMPOSE_PROJECT_NAME=kg
TZ=Asia/Shanghai

# Runtime. The platform forbids database containers in the app stack: point at
# the dedicated data server. Port 39021 is from the assigned range 39020-39029.
KG_DATABASE_URL=mysql+pymysql://knowledge_governance:change_me@172.16.0.244:3306/knowledge_governance?charset=utf8mb4
KG_PUBLISH_PORT=39021
KG_DEMO_MODE=false
KG_DEFAULT_ACTOR=knowledge-governance-admin
KG_PUBLIC_BASE_URL=http://localhost:39021

# DingTalk: an enterprise app credential with Wiki.Workspace.Read and
# Wiki.Node.Read. The operator must be the service (digital-employee) UnionID,
# never a natural person's account — see the ops manual for the incident that
# rule comes from.
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_SYNC_OPERATOR_ID=
# Optional, only when a verified document-body access contract is available.
# Example: https://your-safe-content-gateway/v1/documents/{node_id}/content
DINGTALK_DOC_CONTENT_URL_TEMPLATE=

# bi_center internal read-only contract (optional; leave empty to run without
# employee/department resolution)
BI_CENTER_BASE_URL=
BI_CENTER_INTERNAL_TOKEN=

# OpenAI-compatible model adapter. Do not store actual API keys in the database.
KG_MODEL_API_KEY=
KG_MODEL_ALLOW_CONTENT_TRANSFER=false

# Review-result push over the DingTalk robot. Keep disabled until the robot
# send scope is granted and a test message succeeds (diagnostics page).
KG_NOTIFY_ENABLED=false
# robotCode defaults to DINGTALK_APP_KEY when empty.
KG_ROBOT_CODE=

# Targeted workspace watcher: comma-separated workspace ids, exact names or
# name fragments. The first complete walk of a workspace seeds the mirror
# silently; later walks enqueue reviews for new/changed files and soft-delete
# files missing for KG_WATCH_DELETE_MISSES consecutive walks.
KG_WATCH_WORKSPACES=
KG_WATCH_INTERVAL_SECONDS=300
KG_WATCH_DELETE_MISSES=2

# Audit-trail CDC (exclusive DingTalk fileAuditLogs) and the event->node
# bridge: wiki write events trigger a debounced targeted walk of the touched
# workspace. Scope "watched" walks only already-governed workspaces;
# "mapped" walks any workspace with a learned space mapping.
KG_AUDIT_PULL_ENABLED=false
KG_AUDIT_PULL_INTERVAL_SECONDS=600
KG_AUDIT_ALERT_USER_ID=
KG_BRIDGE_ENABLED=false
KG_BRIDGE_DEBOUNCE_SECONDS=900
KG_BRIDGE_SCOPE=watched

# Review guardrails: only these file classes auto-enter the review queue
# (empty = native_doc,document,sheet,slide,text), and review pushes only go
# to uploaders in the allowlisted workspaces (empty = no restriction).
KG_REVIEW_CLASSES=
KG_NOTIFY_WORKSPACES=
# Pilot observation: redirect every review push to this userId (original
# recipient is named in the body). Empty = push uploaders directly.
KG_NOTIFY_OVERRIDE_USER_ID=
# Machine accounts (userIds AND unionIds, comma-separated): excluded from
# rankings and never auto-reviewed.
KG_ROBOT_USER_IDS=
# Union ids allowed to operate model configs / diagnostics when auth is on.
KG_ADMIN_UNION_IDS=

# Ephemeral body extraction: the org-wide storage-space id behind knowledge
# bases (from an upload response); empty keeps reviews metadata_only.
KG_CONTENT_EXTRACT_ENABLED=true
KG_WIKI_STORAGE_SPACE_ID=
KG_CONTENT_MAX_BYTES=20000000
# Bridge locator: wiki-search events to their workspace before sweeping.
KG_BRIDGE_LOCATOR_ENABLED=true

# Pillar B: log-based CDC over the exclusive DingTalk file-audit trail.
# Requires the org's audit feature enabled and Custom.OpFileAudit.Read.
KG_AUDIT_PULL_ENABLED=false
KG_AUDIT_PULL_INTERVAL_SECONDS=600
# Recipient userId for the workday audit-silence alarm.
KG_AUDIT_ALERT_USER_ID=
