# Runtime
KG_DATABASE_URL=mysql+pymysql://knowledge_governance:change_me@mysql:3306/knowledge_governance?charset=utf8mb4
KG_REDIS_URL=redis://redis:6379/0
KG_DEMO_MODE=false
KG_DEFAULT_ACTOR=knowledge-governance-admin
KG_PUBLIC_BASE_URL=http://localhost:39057

# DingTalk: grant Wiki.Workspace.Read and Wiki.Node.Read.
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# Service sync must use an authorized DingTalk UnionID as operatorId.
DINGTALK_SYNC_OPERATOR_ID=
# Optional, only when a verified document-body access contract is available.
# Example: https://your-safe-content-gateway/v1/documents/{node_id}/content
DINGTALK_DOC_CONTENT_URL_TEMPLATE=

# bi_center internal read-only contract
BI_CENTER_BASE_URL=http://host.docker.internal:39054
BI_CENTER_INTERNAL_TOKEN=

# OpenAI-compatible model adapter. Do not store actual API keys in the database.
KG_MODEL_API_KEY=
KG_MODEL_ALLOW_CONTENT_TRANSFER=false
